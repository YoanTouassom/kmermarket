{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm ci --omit=dev --workspaces=false"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci --include=dev --workspaces=false",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
