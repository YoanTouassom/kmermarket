# ============================================================
#  KmerMarket — variables d'environnement de PRODUCTION
#  À renseigner dans les dashboards Render (backend) et
#  Vercel (frontend). Ne jamais committer de vrais secrets.
# ============================================================

# ---------------- Backend (Render → Environment) ----------------
NODE_ENV=production
# Render fournit PORT automatiquement ; le code lit process.env.PORT.
JWT_SECRET=collez_ici_un_secret_aleatoire_de_64_caracteres_minimum
JWT_EXPIRES_IN=7d
# Injectée automatiquement par render.yaml (fromDatabase) :
# DATABASE_URL=postgresql://...
# Origine(s) du frontend, séparées par des virgules :
CORS_ORIGIN=https://kmer-market.vercel.app
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=KmerMarket
ADMIN_EMAIL=admin@kmermarket.cm
ADMIN_PHONE=+237 6 99 00 11 22
ADMIN_PASSWORD=choisissez_un_mot_de_passe_admin_solide

# ---------------- Frontend (Vercel → Environment Variables) ----------------
# URL publique de l'API Render (avec le préfixe /api) :
VITE_API_URL=https://kmermarket-api.onrender.com/api
