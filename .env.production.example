# ============================================================
#  KmerMarket — variables d'environnement de PRODUCTION
#  À renseigner dans Vercel → Project → Settings → Environment
#  Variables. Ne jamais committer de vrais secrets.
# ============================================================

NODE_ENV=production
JWT_SECRET=collez_ici_un_secret_aleatoire_de_64_caracteres_minimum
JWT_EXPIRES_IN=7d
# Base Neon (neon.tech → Connect → Connection String, « Pooled connection ») :
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------------- Optionnels ----------------
# Frontend et API partagent le même domaine Vercel : CORS inutile par défaut.
# CORS_ORIGIN=https://autre-domaine.com
# Le frontend appelle /api par défaut en production ; à définir seulement
# si l'API est hébergée ailleurs (figée au build) :
# VITE_API_URL=https://api.exemple.com/api

# ---------------- Seed (depuis votre PC, voir DEPLOY.md) ----------------
# ADMIN_EMAIL=admin@kmermarket.cm
# ADMIN_PASSWORD=choisissez_un_mot_de_passe_admin_solide
