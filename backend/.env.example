# ============================================================
#  KmerMarket — Modèle de configuration du backend
#  Copiez ce fichier vers .env puis adaptez les valeurs.
# ============================================================

NODE_ENV=development
PORT=5000

# ---------- PostgreSQL ----------
# Option 1 (recommandée en production : Neon) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/kmermarket?sslmode=require
# Option 2 (développement local) : champs séparés ci-dessous.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_NAME=kmermarket
# DB_SSL : 'true' pour forcer SSL, 'false' pour le désactiver.
# Par défaut : SSL actif si DATABASE_URL est définie, inactif sinon.
# DB_SSL=false
# DB_AUTO_MIGRATE : applique schema.sql au démarrage du serveur ('true' par défaut
# par défaut, mettez 'false' pour désactiver).
# DB_AUTO_MIGRATE=true

# ---------- Authentification ----------
# Générer un secret solide, par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez_moi_avec_un_secret_long_et_aleatoire
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173

# ---------- Compte administrateur de développement (créé par `npm run db:seed`) ----------
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=KmerMarket
ADMIN_EMAIL=admin@kmermarket.cm
ADMIN_PHONE=+237 6 99 00 11 22
ADMIN_PASSWORD=choisissez_un_mot_de_passe_admin
